          },
          "description": "Returns [] until the booking module is built."
        },
        {
          "name": "List Payment History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/customers/me/payments", "host": ["{{baseUrl}}"], "path": ["api", "customers", "me", "payments"] }
          },
          "description": "Returns [] until the booking/payment modules are built."
        },
        {
          "name": "List Consent History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/customers/me/consents", "host": ["{{baseUrl}}"], "path": ["api", "customers", "me", "consents"] }
          }
        },
        {
          "name": "Record Consent",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consentType\": \"marketing_emails\",\n  \"granted\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/customers/me/consents", "host": ["{{baseUrl}}"], "path": ["api", "customers", "me", "consents"] }
          }
        },
        {
          "name": "Export My Data (GDPR)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/customers/me/export", "host": ["{{baseUrl}}"], "path": ["api", "customers", "me", "export"] }
          }
        },
        {
          "name": "Delete My Account (GDPR)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/customers/me", "host": ["{{baseUrl}}"], "path": ["api", "customers", "me"] }
          },
          "description": "Irreversible in practice (see docs). Only run this against a throwaway test account."
        }
      ]
    },
    {
      "name": "Provider",
      "description": "Requires a PROVIDER access token — run Auth > Register (Provider - Individual/Business) first.",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{providerAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/providers/me", "host": ["{{baseUrl}}"], "path": ["api", "providers", "me"] }
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{providerAccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"description\": \"10 years fixing pipes across London\",\n  \"skills\": [\"Plumbing\", \"Leak Repair\", \"Pipe Fitting\"],\n  \"yearsExperience\": 10,\n  \"contactInfo\": \"jane@platform.example\",\n  \"serviceArea\": \"Greater London\",\n  \"website\": \"https://janesplumbing.example.com\",\n  \"directorFirstName\": \"John\",\n  \"directorLastName\": \"Smith\",\n  \"directorContactInfo\": \"john.smith@acme.example\",\n  \"socialLinks\": { \"instagram\": \"https://instagram.com/janesplumbing\" },\n  \"portfolioLinks\": { \"behance\": \"https://behance.net/janesplumbing\" },\n  \"languages\": [\"en\", \"fr\"],\n  \"galleryImages\": [\"https://example.com/gallery1.jpg\", \"https://example.com/gallery2.jpg\"],\n  \"operatingHours\": { \"monday\": { \"open\": \"09:00\", \"close\": \"17:00\" } }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/providers/me", "host": ["{{baseUrl}}"], "path": ["api", "providers", "me"] }
          }
        },
        {
          "name": "List Certifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{providerAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/providers/me/certifications", "host": ["{{baseUrl}}"], "path": ["api", "providers", "me", "certifications"] }
          }
        },
        {
          "name": "Add Certification",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{providerAccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Certified Master Plumber\",\n  \"issuer\": \"UK Plumbing Board\",\n  \"fileUrl\": \"https://example.com/cert.pdf\",\n  \"verificationLink\": \"https://example.com/verify/123\",\n  \"expiryDate\": \"2027-01-01T00:00:00.000Z\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/providers/me/certifications", "host": ["{{baseUrl}}"], "path": ["api", "providers", "me", "certifications"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('certificationId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Certification",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{providerAccessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/providers/me/certifications/{{certificationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "providers", "me", "certifications", "{{certificationId}}"]
            }
          }
        },
        {
          "name": "List My KYC Documents",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{providerAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/providers/me/kyc", "host": ["{{baseUrl}}"], "path": ["api", "providers", "me", "kyc"] }
          }
        },
        {
          "name": "Upload KYC Document (Private)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{providerAccessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": null }]
            },
            "url": { "raw": "{{baseUrl}}/api/uploads/kyc", "host": ["{{baseUrl}}"], "path": ["api", "uploads", "kyc"] }
          },
          "description": "Uploads to the PRIVATE KYC bucket (unlike the generic Uploads > Upload File request). Select a real file for the 'file' field before sending. Run this before 'Submit KYC Document' — it captures the returned path into the 'documentPath' variable.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('documentPath', pm.response.json().path);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit KYC Document",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{providerAccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentType\": \"IDENTITY\",\n  \"documentPath\": \"{{documentPath}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/providers/me/kyc", "host": ["{{baseUrl}}"], "path": ["api", "providers", "me", "kyc"] }
          },
          "description": "documentType is IDENTITY (individuals), or BUSINESS_REGISTRATION / REPRESENTATIVE_IDENTITY (businesses). Run 'Upload KYC Document (Private)' first to populate documentPath.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('kycId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get My KYC Document URL",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{providerAccessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/providers/me/kyc/{{kycId}}/document-url",
              "host": ["{{baseUrl}}"],
              "path": ["api", "providers", "me", "kyc", "{{kycId}}", "document-url"]
            }
          },
          "description": "Returns a signed URL valid for 10 minutes."
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Requires an ADMIN or SUPER_ADMIN access token. There's no public registration for admin accounts — register a normal account, then manually update its role to ADMIN in the database, then run Auth > Login (Admin).",
      "item": [
        {
          "name": "List KYC Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/kyc", "host": ["{{baseUrl}}"], "path": ["api", "admin", "kyc"] }
          }
        },
        {
          "name": "List KYC Requests (Pending Only)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/kyc?status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "kyc"],
              "query": [{ "key": "status", "value": "PENDING" }]
            }
          }
        },
        {
          "name": "Approve KYC Request",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"VERIFIED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/kyc/{{kycId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "kyc", "{{kycId}}"]
            }
          }
        },
        {
          "name": "Reject KYC Request",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REJECTED\",\n  \"rejectionReason\": \"Document image is too blurry to verify\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/kyc/{{kycId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "kyc", "{{kycId}}"]
            }
          },
          "description": "rejectionReason is required when status is REJECTED."
        },
        {
          "name": "Get KYC Document URL",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/kyc/{{kycId}}/document-url",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "kyc", "{{kycId}}", "document-url"]
            }
          },
          "description": "Returns a signed URL valid for 10 minutes, for reviewing any provider's document."
        }
      ]
    },
    {
      "name": "Uploads",
      "description": "Public upload endpoint (see Provider folder for the private KYC upload). Requires any valid access token (customer/provider/admin).",
      "item": [
        {
          "name": "Upload File (Public)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": null }]
            },
            "url": { "raw": "{{baseUrl}}/api/uploads", "host": ["{{baseUrl}}"], "path": ["api", "uploads"] }
          },
          "description": "In Postman, open the Body tab and select a real file for the 'file' field before sending. Allowed types: JPEG, PNG, WebP, PDF, max 10MB. Response is { \"url\": \"...\" } — use that URL in profileImage/coverImage/fileUrl/galleryImages fields elsewhere. This is the PUBLIC bucket — do NOT use it for KYC documents, use Provider > Upload KYC Document (Private) instead. Swap {{accessToken}} for {{providerAccessToken}} or {{adminAccessToken}} depending on which account you're uploading as."
        }
      ]
    }
  ]
}
