NODE_ENV=development
PORT=4000

# PostgreSQL (Supabase) connection strings.
# DATABASE_URL: the pooled "Connection pooling" URI from Supabase (port 6543) — used at runtime.
# DIRECT_URL: the "Direct connection" URI (port 5432) — required by Prisma Migrate, which
#             needs a non-pooled connection to take advisory locks.
DATABASE_URL="postgresql://user:password@localhost:5432/everyskill?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/everyskill?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_RESET_SECRET="change-me-reset-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_RESET_EXPIRES_IN="1h"

# Google OAuth (social login, FR1)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Supabase Storage (file uploads).
# SUPABASE_URL: the Project URL from Supabase dashboard > Settings > API (e.g. https://xxxx.supabase.co).
# SUPABASE_SERVICE_ROLE_KEY: the "service_role" secret key from the same page — server-side only,
#                            never expose this to any client.
# SUPABASE_STORAGE_BUCKET: PUBLIC bucket for profile/cover/gallery images and certification files.
# SUPABASE_KYC_BUCKET: PRIVATE bucket for KYC identity/business documents — only ever accessed via
#                      short-lived signed URLs (see /api/providers/me/kyc/:id/document-url and
#                      /api/admin/kyc/:id/document-url), never a permanent public link.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="change-me-service-role-key"
SUPABASE_STORAGE_BUCKET="everyskill-uploads"
SUPABASE_KYC_BUCKET="everyskill-kyc-private"
