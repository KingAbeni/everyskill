generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ProviderType {
  INDIVIDUAL
  BUSINESS
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  WAITING_FOR_CONFIRMATION
  COMPLETED
  CANCELLED
  DECLINED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  ESCROW
  RELEASED
  REFUNDED
  FAILED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum ReportStatus {
  PENDING
  REVIEWED
  ACTIONED
  DISMISSED
}

enum ReportReason {
  POOR_QUALITY
  FRAUD
  INAPPROPRIATE_BEHAVIOUR
  FAKE_REVIEW
  OFFENSIVE_MESSAGE
  SCAM_PROVIDER
  INAPPROPRIATE_CONTENT
}

enum ReportTargetType {
  USER
  REVIEW
  MESSAGE
  LISTING
  DOCUMENTATION
}

enum ReportActionType {
  WARN
  SUSPEND
  BAN
  DISMISS
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  SMS
}

enum PromotionType {
  DISCOUNT
  CAMPAIGN
  COUPON
}

enum NoShowParty {
  CUSTOMER
  PROVIDER
}

enum DocumentationKind {
  BEFORE
  COMPLETION
  AFTER
}

enum PricingType {
  HOURLY
  FIXED
}

enum ExtraChargeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BillStatus {
  PENDING
  PAID
  OVERDUE
}

enum RescheduleStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum QrTokenKind {
  ARRIVAL
  COMPLETION
}

enum QrTokenStatus {
  PENDING
  USED
  EXPIRED
  INVALIDATED
}

enum XpReason {
  JOB_COMPLETED
  FIVE_STAR_REVIEW
  STREAK_BONUS
  YEARLY_MILESTONE
}

// ---------- Core identity ----------

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  passwordHash      String?
  googleId          String?    @unique
  role              UserRole
  status            UserStatus @default(ACTIVE)
  warningCount      Int        @default(0)
  emailVerified     Boolean    @default(false)
  refreshTokenHash  String?
  passwordResetTokenHash  String?
  passwordResetExpiresAt  DateTime?
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  customerProfile   CustomerProfile?
  providerProfile   ProviderProfile?

  sentMessages      Message[]        @relation("MessageSender")
  notifications     Notification[]
  reportsFiled      Report[]         @relation("ReportReporter")
  consentRecords    ConsentRecord[]
  auditLogs         AuditLog[]       @relation("AuditActor")
  documentation     ServiceDocumentation[]
}

model ConsentRecord {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  consentType String
  granted     Boolean
  createdAt   DateTime @default(now())
}

// ---------- Customer ----------

model CustomerProfile {
  id                  String    @id @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id])
  firstName           String
  lastName             String
  phone               String?
  avatarUrl           String?
  privacyPreferences  Json?
  lateCancellationCount Int     @default(0)
  noShowCount           Int     @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  addresses           Address[]
  favoriteProviders   FavoriteProvider[]
  bookings            Booking[]
  reviews             Review[]
}

model Address {
  id                String          @id @default(uuid())
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])
  label             String?
  line1             String
  line2             String?
  city              String
  state             String?
  country           String
  postalCode        String?
  latitude          Float?
  longitude         Float?
  isDefault         Boolean         @default(false)
}

model FavoriteProvider {
  id                String          @id @default(uuid())
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])
  createdAt         DateTime        @default(now())

  @@unique([customerProfileId, providerProfileId])
}

// ---------- Provider ----------

model ProviderProfile {
  id                  String              @id @default(uuid())
  userId              String              @unique
  user                User                @relation(fields: [userId], references: [id])
  providerType        ProviderType
  displayName         String
  firstName            String?
  lastName             String?
  profileImage        String?
  coverImage           String?
  description          String?
  skills               String[]
  yearsExperience      Int?
  contactInfo          String?
  serviceArea          String?
  latitude             Float?
  longitude            Float?
  website              String?
  directorFirstName    String?
  directorLastName     String?
  directorContactInfo  String?
  socialLinks         Json?
  portfolioLinks      Json?
  languages           String[]
  galleryImages        String[]
  operatingHours      Json?
  verificationStatus  VerificationStatus  @default(PENDING)
  lateCancellationCount Int               @default(0)
  noShowCount           Int               @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  certifications      Certification[]
  kycVerifications    KycVerification[]
  listings            ServiceListing[]
  availabilitySlots   AvailabilitySlot[]
  bookings            Booking[]
  reviews             Review[]
  promotions          Promotion[]
  favoritedBy         FavoriteProvider[]
  balance             ProviderBalance?
  withdrawals         WithdrawalRequest[]
  offlineBills        OfflinePaymentBill[]
  stats               ProviderStats?
  badges              ProviderBadge[]
  xpHistory           ProviderXpHistory[]
}

model Certification {
  id                String          @id @default(uuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])
  name              String
  issuer            String?
  fileUrl           String
  verificationLink  String?
  expiryDate        DateTime?
  createdAt         DateTime        @default(now())
}

model KycVerification {
  id                String              @id @default(uuid())
  providerProfileId String
  providerProfile   ProviderProfile     @relation(fields: [providerProfileId], references: [id])
  documentType      String
  documentPath      String
  status            VerificationStatus  @default(PENDING)
  reviewedById      String?
  rejectionReason   String?
  createdAt         DateTime            @default(now())
  reviewedAt        DateTime?
}

// ---------- Categories & Listings ----------

model Category {
  id       String     @id @default(uuid())
  name     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryToSub", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToSub")

  listings ServiceListing[] @relation("ListingCategories")
}

model ServiceListing {
  id                 String          @id @default(uuid())
  providerProfileId  String
  providerProfile    ProviderProfile @relation(fields: [providerProfileId], references: [id])
  categories         Category[]      @relation("ListingCategories")
  title              String
  description        String
  pricingType        PricingType     @default(FIXED)
  price              Decimal
  durationMinutes    Int
  images             String[]
  serviceArea        String?
  tags               String[]
  cancellationCutoffHours Int        @default(24)
  requiresDocumentation Boolean      @default(true)
  requiresQrVerification Boolean     @default(false)
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  bookings           Booking[]
}

model AvailabilitySlot {
  id                String          @id @default(uuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])
  dayOfWeek         Int?
  date              DateTime?
  startTime         String
  endTime           String
  isBlocked         Boolean         @default(false)
}

// ---------- Booking, Payment, Dispute ----------

model Booking {
  id                String          @id @default(uuid())
  customerId        String
  customer          CustomerProfile @relation(fields: [customerId], references: [id])
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])
  listingId         String
  listing           ServiceListing  @relation(fields: [listingId], references: [id])
  status            BookingStatus   @default(REQUESTED)
  scheduledAt       DateTime
  price             Decimal
  originalPrice      Decimal?
  appliedPromotionId String?
  appliedPromotion   Promotion?     @relation(fields: [appliedPromotionId], references: [id])
  cancelledAt       DateTime?
  cancellationReason String?
  noShowBy          NoShowParty?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  statusHistory     BookingStatusHistory[]
  payment           Payment?
  dispute           Dispute?
  conversation       Conversation?
  review            Review?
  documentation     ServiceDocumentation[]
  extraCharges      ExtraCharge[]
  offlineBills      OfflinePaymentBill[]
  rescheduleRequests RescheduleRequest[]
  qrTokens          BookingQrToken[]
}

model BookingStatusHistory {
  id         String        @id @default(uuid())
  bookingId  String
  booking    Booking       @relation(fields: [bookingId], references: [id])
  fromStatus BookingStatus?
  toStatus   BookingStatus
  changedById String?
  createdAt  DateTime      @default(now())
}

// One-time-use proof-of-presence tokens for the QR verification flow (FR: Booking QR
// Verification). Only the raw token's sha256 hash is ever stored — the raw value is
// returned once, at generation, and never persisted (see qrToken.service.ts).
model BookingQrToken {
  id            String        @id @default(uuid())
  bookingId     String
  booking       Booking       @relation(fields: [bookingId], references: [id])
  kind          QrTokenKind
  tokenHash     String
  status        QrTokenStatus @default(PENDING)
  expiresAt     DateTime
  generatedById String
  usedById      String?
  usedAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([bookingId])
  @@index([tokenHash])
}

model Payment {
  id             String        @id @default(uuid())
  bookingId      String        @unique
  booking        Booking       @relation(fields: [bookingId], references: [id])
  amount         Decimal
  gateway        String
  status         PaymentStatus @default(PENDING)
  transactionRef String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// ---------- Reschedule requests (alternative to a late cancellation) ----------

model RescheduleRequest {
  id            String           @id @default(uuid())
  bookingId     String
  booking       Booking          @relation(fields: [bookingId], references: [id])
  proposedAt    DateTime
  requestedById String
  status        RescheduleStatus @default(PENDING)
  respondedAt   DateTime?
  createdAt     DateTime         @default(now())
}

// ---------- Extra charges (mid-job price increases) ----------

model ExtraCharge {
  id             String            @id @default(uuid())
  bookingId      String
  booking        Booking           @relation(fields: [bookingId], references: [id])
  amount         Decimal
  reason         String
  status         ExtraChargeStatus @default(PENDING)
  requestedById  String
  respondedAt    DateTime?
  paymentStatus  PaymentStatus?
  gateway        String?
  transactionRef String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

// ---------- Provider earnings, withdrawals, platform commission ----------

model PlatformSettings {
  id                String   @id @default(uuid())
  commissionPercent Decimal  @default(10.0)
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ProviderBalance {
  id                String          @id @default(uuid())
  providerProfileId String          @unique
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])
  availableBalance  Decimal         @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model WithdrawalRequest {
  id                String          @id @default(uuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])
  amount            Decimal
  createdAt         DateTime        @default(now())
}

// Commission owed to the platform when a customer pays a provider directly ("offline"),
// bypassing Stripe (see Payment.gateway = "offline" / ExtraCharge.gateway = "offline").
// Unpaid past dueAt -> provider is suspended (see the billing cron job).
model OfflinePaymentBill {
  id                String          @id @default(uuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])
  bookingId         String
  booking           Booking         @relation(fields: [bookingId], references: [id])
  sourceType        String          // "BOOKING_PAYMENT" | "EXTRA_CHARGE"
  amount            Decimal
  status            BillStatus      @default(PENDING)
  dueAt             DateTime
  paidAt            DateTime?
  paidVia           String?         // "stripe" | "balance"
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Dispute {
  id          String        @id @default(uuid())
  bookingId   String        @unique
  booking     Booking       @relation(fields: [bookingId], references: [id])
  raisedById  String
  reason      String
  status      DisputeStatus @default(OPEN)
  resolution  String?
  resolvedById String?
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
}

model ServiceDocumentation {
  id           String            @id @default(uuid())
  bookingId    String
  booking      Booking           @relation(fields: [bookingId], references: [id])
  kind         DocumentationKind
  imageUrl     String
  uploadedById String
  uploadedBy   User              @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime          @default(now())
}

// ---------- Messaging ----------

model Conversation {
  id        String    @id @default(uuid())
  bookingId String    @unique
  booking   Booking   @relation(fields: [bookingId], references: [id])
  createdAt DateTime  @default(now())

  messages  Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  content        String?
  imageUrl       String?
  createdAt      DateTime     @default(now())
}

// ---------- Notifications ----------

model Notification {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  type        String
  channel     NotificationChannel
  content     String
  referenceId String?
  isRead      Boolean             @default(false)
  createdAt   DateTime            @default(now())
}

// ---------- Reviews ----------

model Review {
  id                String          @id @default(uuid())
  bookingId         String          @unique
  booking           Booking         @relation(fields: [bookingId], references: [id])
  customerId        String
  customer          CustomerProfile @relation(fields: [customerId], references: [id])
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])
  rating            Int
  comment           String?
  images            String[]
  providerReply     String?
  providerRepliedAt DateTime?
  createdAt         DateTime        @default(now())
}

// ---------- Moderation ----------

// reporterId is nullable to support system-filed reports (FR20's automatic suspicious-image
// detection on listing/review/documentation uploads) — those have no human reporter.
model Report {
  id             String            @id @default(uuid())
  reporterId     String?
  reporter       User?             @relation("ReportReporter", fields: [reporterId], references: [id])
  targetType     ReportTargetType
  targetId       String
  reason         ReportReason
  description    String?
  images         String[]
  status         ReportStatus      @default(PENDING)
  actionTaken    ReportActionType?
  resolutionNote String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
}

// ---------- Promotions ----------

model Promotion {
  id                String          @id @default(uuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])
  type              PromotionType
  code              String?
  details           Json?
  validFrom         DateTime
  validTo           DateTime
  isActive          Boolean         @default(true)
  maxRedemptions    Int?
  timesRedeemed     Int             @default(0)
  createdAt         DateTime        @default(now())

  bookings          Booking[]
}

// ---------- Admin / audit ----------

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
}

// ---------- Provider Gamification ----------

model ProviderStats {
  id                  String          @id @default(uuid())
  providerProfileId   String          @unique
  providerProfile     ProviderProfile @relation(fields: [providerProfileId], references: [id])
  totalXp             Int             @default(0)
  currentTierId       String?
  currentTier         TierLevel?      @relation(fields: [currentTierId], references: [id])
  completedJobs       Int             @default(0)
  currentStreak       Int             @default(0)
  longestStreak       Int             @default(0)
  fiveStarReviewCount Int             @default(0)
  lastYearlyMilestoneYear Int?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

// Admin-configurable list of tiers (not a singleton — admins can add new tiers /
// rename existing ones), ordered by `order` ascending from lowest to highest.
model TierLevel {
  id        String          @id @default(uuid())
  name      String          @unique
  minXp     Int             @unique
  order     Int             @unique
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  providerStats ProviderStats[]
}

model ProviderXpHistory {
  id                String          @id @default(uuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])
  amount            Int
  reason            XpReason
  relatedBookingId  String?
  createdAt         DateTime        @default(now())

  @@index([providerProfileId])
}

model Achievement {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  description String
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  badges      ProviderBadge[]
}

model ProviderBadge {
  id                String          @id @default(uuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])
  achievementId     String
  achievement       Achievement     @relation(fields: [achievementId], references: [id])
  earnedAt          DateTime        @default(now())

  @@unique([providerProfileId, achievementId])
}

// Singleton row (same pattern as PlatformSettings) holding the configurable XP amounts.
model GamificationSettings {
  id                  String   @id @default(uuid())
  xpPerCompletedJob   Int      @default(50)
  xpPerFiveStarReview Int      @default(30)
  xpStreakBonusEvery  Int      @default(5)
  xpStreakBonusAmount Int      @default(25)
  xpPerYearMilestone  Int      @default(100)
  updatedById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
